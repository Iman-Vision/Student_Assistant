# Supabase (Project Settings -> API -> Project URL)
SUPABASE_URL=https://your-project.supabase.co

# Only needed if your project still uses a legacy shared JWT secret
# (Project Settings -> API -> JWT Keys -> "Legacy JWT Secret", if present).
# Leave unset if you don't see that option — SUPABASE_URL alone is enough.
SUPABASE_JWT_SECRET=


# GROQ API Key
GROQ_API_KEY=your_groq_api_key_here

# Comma-separated list of allowed frontend origins
FRONTEND_ORIGIN=http://localhost:5173
